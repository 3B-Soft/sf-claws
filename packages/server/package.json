{
  "name": "@sf-claws/server",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "bun --bun tsc -p tsconfig.json",
    "typecheck": "bun --bun tsc -p tsconfig.json --noEmit",
    "dev": "bun --watch src/index.ts",
    "start": "bun dist/index.js",
    "test": "bun --bun vitest run",
    "eval": "bun --bun vitest run -c vitest.eval.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/static": "^10.0.0",
    "@octokit/rest": "^22.0.0",
    "@sf-claws/shared": "*",
    "fast-xml-parser": "^5.0.0",
    "fastify": "^5.0.0",
    "jose": "^6.0.0",
    "jsforce": "^3.10.0",
    "jszip": "^3.10.0",
    "openai": "^7.0.0",
    "pino-pretty": "^13.0.0",
    "zod": "^4.0.0",
    "diff": "^9.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
