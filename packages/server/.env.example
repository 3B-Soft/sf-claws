# ---- SF Claws server ----
PORT=8787
HOST=0.0.0.0
# Public URL of this server (used for OAuth callbacks and pairing links), no trailing slash
PUBLIC_URL=http://localhost:8787
# Where the SQLite database and session workspaces live
DATA_DIR=./data
# 32+ random bytes, base64. Encrypts Salesforce refresh tokens, GitHub tokens and AI API keys at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=
# Secret for signing JWTs (any long random string)
JWT_SECRET=
# JWT lifetime
JWT_TTL_HOURS=72
# Optional fallback Salesforce Connected App. Each org normally carries its own Consumer Key/Secret,
# entered when the org is added in the admin console; these apply only to orgs saved without one.
# Callback: ${PUBLIC_URL}/api/v1/oauth/salesforce/callback
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# Comma separated origins allowed for CORS (admin UI dev server, chrome-extension://<id>)
CORS_ORIGINS=http://localhost:5173
# Serve the built admin UI from this directory (relative to server cwd). Leave empty to disable.
ADMIN_UI_DIST=../admin-ui/dist
# Directory with default skills (*.md) seeded on first boot
SKILLS_SEED_DIR=../../skills
# Log level: trace|debug|info|warn|error
LOG_LEVEL=info
# Trust X-Forwarded-For / X-Forwarded-Proto from the upstream proxy (true|false, default false).
# Turn on ONLY when a reverse proxy (nginx, Caddy, a cloud load balancer) sits in front of the
# server and overwrites those headers. Without a proxy, trusting them lets any caller choose the
# IP written to the audit log and used as the rate-limit key.
TRUST_PROXY=false
# Optional: bootstrap a super admin on first boot instead of "first registered user"
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
