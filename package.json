{
  "name": "sf-claws",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.3.12",
  "description": "Salesforce-focused agentic harness for implementation admins: Chrome side-panel plugin + Bun control plane.",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/admin-ui",
    "packages/extension"
  ],
  "engines": {
    "bun": ">=1.3.12"
  },
  "scripts": {
    "build": "bun run --filter @sf-claws/shared build && bun run --filter @sf-claws/server build && bun run --filter @sf-claws/admin-ui build && bun run --filter @sf-claws/extension build",
    "dev:server": "bun run --filter @sf-claws/server dev",
    "dev:admin": "bun run --filter @sf-claws/admin-ui dev",
    "dev:extension": "bun run --filter @sf-claws/extension dev",
    "test": "bun run --filter '*' test",
    "eval": "bun run --filter @sf-claws/server eval",
    "typecheck": "bun run --filter @sf-claws/shared build && bun run --filter '*' typecheck",
    "demo": "bun tools/demo-server.mjs",
    "screenshots": "bun tools/screenshots.mjs",
    "contrast": "bun tools/contrast-audit.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "playwright": "^1.63.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@salesforce/source-deploy-retrieve": "^13.3.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/3B-Soft/sf-claws.git"
  },
  "homepage": "https://github.com/3B-Soft/sf-claws#readme",
  "bugs": {
    "url": "https://github.com/3B-Soft/sf-claws/issues"
  }
}
